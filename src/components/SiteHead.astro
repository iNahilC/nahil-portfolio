---
import { paths, type Locale } from '../i18n/content';
interface Props { locale: Locale; page: 'home' | 'caseStudy'; title: string; description: string }
const { locale, page, title, description } = Astro.props;
const origin = 'https://nahilrojas.sparked.network';
---
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="theme-color" content="#f0f2ee" />
<meta name="description" content={description} />
<meta property="og:type" content={page === 'home' ? 'website' : 'article'} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:locale" content={locale === 'es' ? 'es_DO' : 'en_US'} />
<link rel="canonical" href={origin + paths[locale][page]} />
<link rel="alternate" hreflang="es" href={origin + paths.es[page]} />
<link rel="alternate" hreflang="en" href={origin + paths.en[page]} />
<link rel="alternate" hreflang="x-default" href={origin + paths.es[page]} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Syne:wght@500;600;700;800&display=swap" rel="stylesheet" />
<title>{title}</title>
