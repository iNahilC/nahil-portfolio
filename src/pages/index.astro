---
import '../styles/global.css';

const pageTitle = 'Nahil Rojas | Desarrollador de software';
const description = 'Portafolio de Nahil Enmanuel Rojas Morel. Desarrollo web, backend, bots y sistemas conectados. Proyectos: CBRM y Ferrefacturas.';
const cvPath = '/Nahil_Enmanuel_Rojas_Morel_CV.pdf';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f0f2ee" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Syne:wght@500;600;700;800&display=swap" rel="stylesheet" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <header class="site-header">
      <div class="header-inner shell">
        <a class="wordmark" href="#inicio" aria-label="Nahil Rojas, inicio"><span class="wordmark-symbol">N<span>.</span></span><span>NAHIL ROJAS</span></a>
        <nav class="main-nav" aria-label="Navegación principal">
          <a href="#proyectos">Proyectos</a>
          <a href="#perfil">Perfil</a>
          <a href="#contacto">Contacto</a>
        </nav>
        <a class="header-cv" href={cvPath} download>Descargar CV <span aria-hidden="true">↗</span></a>
      </div>
    </header>

    <main id="contenido">
      <section class="hero shell" id="inicio" aria-labelledby="hero-title">
        <div class="hero-rail" aria-hidden="true"><span>01 / PORTAFOLIO</span><span>2026</span></div>
        <div class="hero-main">
          <p class="eyebrow"><span class="status-mark" aria-hidden="true"></span> DESARROLLADOR DE SOFTWARE · SANTO DOMINGO, RD</p>
          <h1 id="hero-title">De la interfaz al <em>sistema</em> que la sostiene<span class="period">.</span></h1>
          <div class="hero-bottom">
            <p>Soy Nahil Enmanuel Rojas Morel. Desarrollo aplicaciones web, bots y servicios que conectan usuarios, APIs y datos.</p>
            <div class="hero-actions">
              <a class="button button-primary" href="#proyectos">Ver proyectos <span aria-hidden="true">↘</span></a>
              <a class="text-link" href={cvPath} download>Descargar CV <span aria-hidden="true">↗</span></a>
            </div>
          </div>
        </div>
        <div class="hero-corner" aria-hidden="true"><span>WEB</span><span>BOTS</span><span>DATOS</span></div>
      </section>

      <section class="selected-work" id="proyectos" aria-labelledby="work-title">
        <div class="shell">
          <div class="section-heading">
            <div><p class="section-index">02 / TRABAJO SELECCIONADO</p><h2 id="work-title">Proyectos reales<span class="period">.</span></h2></div>
            <p>Producto, lógica e integración.<br />Dos proyectos con problemas distintos.</p>
          </div>

          <article class="project project-cbrm" aria-labelledby="cbrm-title">
            <div class="project-image">
              <img src="/cbrm-case.webp" alt="Arte de Counter Blox Ranked Matchmaking utilizado por la plataforma CBRM" loading="lazy" width="1920" height="1080" />
              <div class="image-topline"><span>CASO 01</span><span>WEB · BOT · MATCHMAKING</span></div>
              <div class="image-bottomline"><span>CB:RM</span><a href="https://www.playcbrm.xyz/" target="_blank" rel="noopener noreferrer" aria-label="Abrir la web pública de CBRM">Ver plataforma <span aria-hidden="true">↗</span></a></div>
            </div>
            <div class="project-copy">
              <div class="project-intro"><p class="project-kicker">DESDE 2025 · DESARROLLO TÉCNICO</p><h3 id="cbrm-title">CBRM</h3><p>Una experiencia competitiva construida alrededor de partidas, identidad verificada y clasificaciones.</p></div>
              <div class="metric-row" aria-label="Alcance de CBRM">
                <div><strong>28 mil+</strong><span>jugadores en Roblox</span></div>
                <div><strong>9 mil+</strong><span>miembros en Discord</span></div>
                <div><strong>60+</strong><span>partidas diarias</span></div>
              </div>
              <div class="scope"><p class="small-label">MI CONTRIBUCIÓN</p><ul><li>Sitio web y experiencia de usuario</li><li>Bots de verificación y sistema ELO</li><li>Matchmaking e integración de servicios</li></ul></div>
              <div class="project-footer"><p>JavaScript / TypeScript · Node.js · Express · Prisma · MySQL · Astro · Discord API · Roblox OAuth</p><a class="project-link" href="https://www.playcbrm.xyz/" target="_blank" rel="noopener noreferrer">Explorar la web <span aria-hidden="true">↗</span></a></div>
            </div>
          </article>

          <article class="project project-ferre" aria-labelledby="ferre-title">
            <div class="ferre-copy"><p class="project-kicker">CASO 02 · PROYECTO PRIVADO EN DESARROLLO</p><h3 id="ferre-title">Ferrefacturas<span class="period">.</span></h3><p class="ferre-lead">De una factura en foto a información útil para el negocio.</p><p>Aplicación web para cargar facturas, extraer datos con IA, revisar resultados y consultar ventas y productos. El flujo incluye exportación a Excel.</p><div class="ferre-tags"><span>Astro</span><span>TypeScript</span><span>Supabase</span><span>Gemini</span></div><p class="private-note">Repositorio privado · Sin demostración pública</p></div>
            <div class="ferre-visual" aria-label="Flujo de Ferrefacturas: capturar factura, extraer datos, revisar y exportar">
              <div class="visual-caption"><span>FLUJO DEL PRODUCTO</span><span>01 — 04</span></div>
              <div class="process-line"><div><span>01</span><strong>Capturar</strong><small>Factura</small></div><div><span>02</span><strong>Extraer</strong><small>IA</small></div><div><span>03</span><strong>Revisar</strong><small>Datos</small></div><div><span>04</span><strong>Exportar</strong><small>Excel</small></div></div>
              <div class="visual-footer"><span>ENTRADA</span><span>→</span><span>INFORMACIÓN UTILIZABLE</span></div>
            </div>
          </article>
        </div>
      </section>

      <section class="profile shell" id="perfil" aria-labelledby="profile-title">
        <div class="profile-heading"><p class="section-index">03 / PERFIL</p><h2 id="profile-title">Cómo trabajo<span class="period">.</span></h2></div>
        <div class="profile-content"><p class="profile-statement">Me interesa el recorrido completo: entender el problema, diseñar el flujo y conectar cada pieza hasta que funcione para quien lo usa.</p><div class="profile-details"><p>Comencé a desarrollar bots de Discord en 2019. Desde 2025 trabajo en CBRM, combinando web, backend, datos e integraciones. También desarrollo Ferrefacturas a partir de necesidades reales de gestión en una ferretería.</p><div class="skill-lines"><div><span>01</span><strong>Backend y APIs</strong><small>Node.js · Express · OAuth</small></div><div><span>02</span><strong>Datos</strong><small>SQL · MySQL · Prisma · Supabase</small></div><div><span>03</span><strong>Web y herramientas</strong><small>TypeScript · Astro · Git / GitHub</small></div></div></div></div>
      </section>

      <section class="contact" id="contacto" aria-labelledby="contact-title"><div class="shell contact-inner"><p class="section-index">04 / CONTACTO</p><div class="contact-row"><h2 id="contact-title">Hablemos de lo que viene<span class="period">.</span></h2><div class="contact-actions"><a class="button button-light" href="mailto:NahilEnmanuel58@gmail.com">Escribirme <span aria-hidden="true">↗</span></a><a href="https://github.com/iNahilC" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a><a href={cvPath} download>Descargar CV <span aria-hidden="true">↗</span></a></div></div><div class="contact-bottom"><span>NAHIL ENMANUEL ROJAS MOREL</span><span>SANTO DOMINGO · REPÚBLICA DOMINICANA</span><a href="#inicio">VOLVER ARRIBA ↑</a></div></div></section>
    </main>
  </body>
</html>
